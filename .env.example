# Copy this file to `.env` and fill in your real values.

API_ID=0
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here
OWNER_IDS=123456789

OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional tuning
# MAX_DAILY_AI_CALLS=100
# LOW_CREDITS_THRESHOLD=0.05
